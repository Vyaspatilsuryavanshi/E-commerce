SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database
USE_POSTGRES=False
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Production
SECURE_SSL_REDIRECT=True

# Razorpay (use Test Mode credentials first; configure live credentials only after validation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (development defaults to console; configure SMTP for production password resets)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AURA LUXE <no-reply@your-domain.example>

# Abandoned online order inventory reservation expiry
PENDING_PAYMENT_EXPIRY_MINUTES=30
